# ---- Server ----
# 4100 so it doesn't clash with other local projects on 4000. If you change it, also change
# VITE_API_URL in the project root's .env.local.
PORT=4100
NODE_ENV=development
# Comma-separated list of frontend origins allowed to call the API.
# (In development any http://localhost:<port> is allowed as well.)
CORS_ORIGIN=http://localhost:8080
# Public URL of the storefront (used in password-reset links)
APP_URL=http://localhost:8080
# Public URL of this API (used for links to files in ./uploads). Defaults to http://localhost:PORT
# API_URL=http://localhost:4100

# ---- MongoDB ----
# Local MongoDB or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/kh_luxury

# ---- Auth ----
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- First admin account (created by `npm run db:seed`) ----
ADMIN_NAME=KH Luxury Admin
ADMIN_EMAIL=admin@khluxury.com
ADMIN_PASSWORD=change-me-Admin123!

# Uploaded files are stored locally under server/uploads.

# ---- Email (optional: https://resend.com) for password-reset emails ----
RESEND_API_KEY=
MAIL_FROM=KH Luxury <no-reply@yourdomain.com>
